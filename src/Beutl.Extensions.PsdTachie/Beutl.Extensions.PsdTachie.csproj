<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.13">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.PsdTachie</PackageId>
        <Title>PSD立ち絵</Title>
        <Description>PSDやZIPの立ち絵パーツを切り替えて表示し、口パクと目パチを自動で行う立ち絵オブジェクトを追加します</Description>
        <PackageTags>psd,tachie,lipsync,character,立ち絵,口パク</PackageTags>
        <Version>0.1.7</Version>
        <AssemblyVersion>0.1.7.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Beutl.Engine.SourceGenerators"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            Version="2.0.0-preview.13"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.PsdTachie.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
